<Window x:Class="WaterAuto.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр"
        Width="1000" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg.App}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: что за файл и его формат. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="Предпросмотр выпуска" />
                    <TextBlock x:Name="FileNameText" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Pill.Neutral}" VerticalAlignment="Center"
                        Margin="16,0,0,0">
                    <TextBlock x:Name="KindText" Style="{StaticResource Text.Caption}" Text="—" />
                </Border>
            </Grid>
        </Border>

        <!-- Ошибка чтения файла: сообщение в окне, без MessageBox. -->
        <Border x:Name="ErrorBanner" Grid.Row="1" Visibility="Collapsed" Margin="20,12,20,0" Padding="12,8"
                CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource Brush.Error.Soft}" BorderBrush="{DynamicResource Brush.Error}">
            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Error}" />
        </Border>

        <!-- Содержимое: таблица спецификации (xlsx) или текст записки (docx). -->
        <Grid Grid.Row="2" Margin="20,12,20,12">
            <Border x:Name="TableCard" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <DataGrid x:Name="Table" BorderThickness="0" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False"
                          CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                          RowHeight="32" ColumnHeaderHeight="30"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>

            <Border x:Name="TextCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <TextBox x:Name="TextPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         VerticalContentAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>
        </Grid>

        <!-- Низ: краткая статистика и действия. -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="InfoText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" Text="" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenButton" Style="{StaticResource Button.Primary}" MinWidth="200"
                            Content="Открыть в приложении" Click="OnOpen"
                            ToolTip="Открыть файл в программе, назначенной для этого формата (Excel/Word/LibreOffice)" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Закрыть" IsCancel="True"
                            MinWidth="120" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
