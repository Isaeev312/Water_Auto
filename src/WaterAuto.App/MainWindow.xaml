<Window x:Class="WaterAuto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Water_Auto — расчёт АУПТ по СП 485" Height="720" Width="1100"
        FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="Расчёт по чертежу" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Foreground="#555" TextWrapping="Wrap"
                   Text="Проект (*.waproj) ссылается на план DWG/DXF по соглашению о слоях и содержит исходные данные. Новый проект создаётся рядом с выбранным чертежом." />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Проект:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ProjectBox" Grid.Column="1" Padding="4" />
            <Button Grid.Column="2" Content="Открыть…" Margin="8,0,0,0" Padding="12,4" Click="OnOpenProject" />
            <Button Grid.Column="3" Content="Новый по чертежу…" Margin="8,0,0,0" Padding="12,4" Click="OnNewProject" />
            <TextBlock Grid.Row="1" Text="Папка выпуска:" VerticalAlignment="Center" Margin="0,8,8,0" />
            <TextBox x:Name="OutBox" Grid.Row="1" Grid.Column="1" Padding="4" Margin="0,8,0,0" />
            <Button Grid.Row="1" Grid.Column="2" Content="Файл проекта" Margin="8,8,0,0" Padding="12,4"
                    ToolTip="Открыть JSON проекта во внешнем редакторе (для служебных полей)" Click="OnEditProject" />
            <Button Grid.Row="1" Grid.Column="3" Content="Исходные данные…" Margin="8,8,0,0" Padding="12,4"
                    ToolTip="Ввод данных объекта, спринклерной установки, насосной, ВПВ, резервуара и титульного листа" Click="OnEditData" />
            <Button x:Name="RunButton" Grid.Row="1" Grid.Column="4" Content="Рассчитать" Margin="8,8,0,0" Padding="12,4"
                    FontWeight="SemiBold" Click="OnRun" />
        </Grid>

        <Border DockPanel.Dock="Top" Background="#F3F6FA" CornerRadius="4" Padding="12" Margin="0,4,0,8">
            <StackPanel>
                <TextBlock x:Name="Summary" TextWrapping="Wrap" Text="Выберите проект и нажмите «Рассчитать»." />
                <TextBlock x:Name="DesignSummary" TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Файлы выпуска (двойной щелчок — открыть)" Margin="0,0,0,4" />
                <Button DockPanel.Dock="Bottom" Content="Открыть папку" Margin="0,8,0,0" Padding="12,4" Click="OnOpenFolder" />
                <ListBox x:Name="Files" MouseDoubleClick="OnOpenFile" />
            </DockPanel>
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Замечания" Margin="0,0,0,4" />
                <DataGrid x:Name="Issues" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="90" />
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="170" />
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Пункт" Binding="{Binding Clause}" Width="90" />
                        <DataGridTextColumn Header="Место, мм" Binding="{Binding Location}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
