<Window x:Class="WaterAuto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Water_Auto — расчёт водяных АУПТ по СП 485"
        Height="800" Width="1240" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.App}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка приложения: марка, название, тема и акцент. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.Brand}"
                        VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22">
                        <Path Fill="{DynamicResource Brush.Text.OnBrand}"
                              Data="M10,1 C10,1 3,9 3,13 A7,7 0 0 0 17,13 C17,9 10,1 10,1 Z" />
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.H2}" Text="Water_Auto" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Расчёт водяных автоматических установок пожаротушения по СП 485" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Style="{StaticResource Button.Ghost}" Click="OnToggleTheme"
                            ToolTip="Переключить светлую/тёмную тему" Padding="10,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16">
                                <Grid x:Name="SunGroup">
                                    <Ellipse Width="8.4" Height="8.4" Fill="{DynamicResource Brush.Text.Secondary}" />
                                    <Path Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.4"
                                          Data="M8,0.8 L8,2.6 M8,13.4 L8,15.2 M0.8,8 L2.6,8 M13.4,8 L15.2,8 M2.9,2.9 L4.2,4.2 M11.8,11.8 L13.1,13.1 M13.1,2.9 L11.8,4.2 M4.2,11.8 L2.9,13.1" />
                                </Grid>
                                <Path x:Name="MoonIcon" Visibility="Collapsed" Fill="{DynamicResource Brush.Text.Secondary}"
                                      Data="M13.5,9.6 A6.5,6.5 0 1 1 6.4,2.5 A5.2,5.2 0 0 0 13.5,9.6 Z" />
                            </Grid>
                            <TextBlock x:Name="ThemeLabel" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" Text="Тема" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsButton" Style="{StaticResource Button.Ghost}" Click="OnOpenSettings"
                            ToolTip="Оформление и поведение: тема, акцент, автоматический расчёт (Ctrl+,)" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Fill="{DynamicResource Brush.Text.Secondary}"
                                  Data="M8,5.2 A2.8,2.8 0 1 0 8,10.8 A2.8,2.8 0 1 0 8,5.2 Z M8,4.2 A3.8,3.8 0 1 1 8,11.8 A3.8,3.8 0 1 1 8,4.2 Z M7.2,0.8 L8.8,0.8 L9.1,2.3 A5.9,5.9 0 0 1 10.5,3.1 L11.9,2.5 L12.7,3.9 L11.6,4.9 A5.9,5.9 0 0 1 11.6,6.7 L12.7,7.7 L11.9,9.1 L10.5,8.5 A5.9,5.9 0 0 1 9.1,9.3 L8.8,10.8 L7.2,10.8 L6.9,9.3 A5.9,5.9 0 0 1 5.5,8.5 L4.1,9.1 L3.3,7.7 L4.4,6.7 A5.9,5.9 0 0 1 4.4,4.9 L3.3,3.9 L4.1,2.5 L5.5,3.1 A5.9,5.9 0 0 1 6.9,2.3 Z" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}"
                                       Text="Настройки" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Рабочая область: слева проект и исходные данные, справа сводка и выпуск. -->
        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Шаг 1. Проект. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.H3}" Text="1 · Проект" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                       Text="Проект *.waproj ссылается на чертёж DWG/DXF и хранит исходные данные." />

                            <TextBlock Style="{StaticResource Text.Label}" Text="Последние проекты" />
                            <ComboBox x:Name="RecentBox" Margin="0,4,0,0" SelectionChanged="OnRecentChanged" />
                            <TextBlock x:Name="ProjectPathText" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" Text="Проект не выбран" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Открыть проект…" Style="{StaticResource Button.Secondary}"
                                        Click="OnOpenProject" ToolTip="Открыть проект *.waproj (Ctrl+O)" />
                                <Button Grid.Column="1" Content="JSON" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                        Click="OnEditProject" ToolTip="Открыть файл проекта во внешнем редакторе (служебные поля)" />
                                <Button Grid.Column="2" Content="Папка" Style="{StaticResource Button.Ghost}" Margin="4,0,0,0"
                                        Click="OnOpenOutFolder" ToolTip="Открыть папку выпуска" />
                            </Grid>

                            <Separator Margin="0,12" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="Папка выпуска" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutBox" Grid.Column="0" />
                                <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource Button.Secondary}"
                                        Margin="8,0,0,0" Click="OnBrowseOut" />
                            </Grid>

                            <Separator Margin="0,12" />
                            <TextBlock Style="{StaticResource Text.H3}" Text="Новый проект по чертежу"
                                       ToolTip="Быстрый проект: чертёж, группа помещений и ороситель — остальное программа подставит по геометрии и посчитает." />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Быстрый проект…" Style="{StaticResource Button.Primary}"
                                        Click="OnQuickProject"
                                        ToolTip="Чертёж + группа помещений: программа создаст проект, подставит оценки по чертежу и выполнит расчёт" />
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Создать из DWG…" Style="{StaticResource Button.Secondary}"
                                        HorizontalAlignment="Stretch" Click="OnNewProject" />
                                <Button Grid.Column="1" Content="Шаблон DWG…" Style="{StaticResource Button.Secondary}"
                                        Margin="8,0,0,0" Click="OnTemplate"
                                        ToolTip="Шаблон слоёв ПТ_ для архитектурного плана (единицы — мм)" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Шаг 2. Исходные данные. -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.H3}" Text="2 · Исходные данные" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                       Text="Только данные объекта и решения проектировщика — нормы и каталоги программа берёт из data/." />
                            <Button x:Name="EditDataButton" Content="Открыть мастер исходных данных…"
                                    Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"
                                    Click="OnEditData" ToolTip="Проверить и заполнить исходные данные проекта (Ctrl+E)" />
                            <Border Style="{StaticResource Card.Inset}" Margin="0,10,0,0">
                                <TextBlock x:Name="DesignSummary" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Text="Проект не выбран — выберите файл проекта или создайте его по чертежу." />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Проверка проекта: готовность чертежа до расчёта (информационно, кнопку «Рассчитать» не блокирует).
                     После расчёта карточка скрывается: её место занимает сводка и выпуск. -->
                <Border x:Name="CheckCard" Grid.Row="0" Style="{StaticResource Card}" Padding="12,10"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource Text.H3}" Text="Проверка проекта" VerticalAlignment="Center" />
                        <Border x:Name="CheckStatusPill" Grid.Column="1" Style="{StaticResource Pill.Neutral}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock x:Name="CheckStatusText" Style="{StaticResource Text.Caption}"
                                       Text="Проект не выбран" />
                        </Border>
                        <Button x:Name="CheckButton" Grid.Column="2" Style="{StaticResource Button.Ghost}"
                                Content="Проверить" Padding="8,2" Click="OnCheckProject"
                                ToolTip="Проверить чертёж и исходные данные до расчёта" />

                        <TextBlock x:Name="CheckDetails" Grid.Row="1" Grid.ColumnSpan="3"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" Visibility="Collapsed" Text="" />
                        <ProgressBar x:Name="CheckProgress" Grid.Row="1" Grid.ColumnSpan="3"
                                     Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Сводка расчёта. -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel x:Name="SummaryEmpty" VerticalAlignment="Center" Margin="0,6">
                            <TextBlock Style="{StaticResource Text.H3}" Text="Сводка появится после расчёта" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Расход и напор насоса, запас воды, подобранная установка насосной и количество замечаний." />
                        </StackPanel>

                        <StackPanel x:Name="SummaryFilled" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Расход насоса" />
                                    <TextBlock x:Name="FlowValue" Style="{StaticResource Text.H1}" Text="—" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="л/с" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Напор насоса" />
                                    <TextBlock x:Name="HeadValue" Style="{StaticResource Text.H1}" Text="—" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="м" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Запас воды" />
                                    <TextBlock x:Name="VolumeValue" Style="{StaticResource Text.H1}" Text="—" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="м³" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Замечаний" />
                                    <TextBlock x:Name="IssuesValue" Style="{StaticResource Text.H1}" Text="—" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="проверить" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Card.Inset}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Label}" Text="Насосная установка"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="PumpSelectButton" Grid.Column="1" Content="Подбор установки…"
                                                Style="{StaticResource Button.Secondary}" Padding="10,4" MinHeight="28"
                                                Visibility="Collapsed" Click="OnSelectPumpSet"
                                                ToolTip="Выбрать комплектную установку из каталога data/catalog/pump_sets_*.json или вернуть автоподбор по расчётным Q и H (Q и H — из последнего расчёта)" />
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock x:Name="PumpSetValue" Style="{StaticResource Text.Value}" TextWrapping="Wrap"
                                                       Text="—" />
                                            <TextBlock x:Name="PumpCountsValue" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                       Text="" />
                                            <TextBlock x:Name="PumpRoomValue" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" Visibility="Collapsed" Text="" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Canvas x:Name="PumpChartCanvas" Width="260" Height="120"
                                                    HorizontalAlignment="Left" ClipToBounds="True" Visibility="Collapsed" />
                                            <TextBlock x:Name="PumpChartHint" Style="{StaticResource Text.Caption}" Width="260"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                                       Text="Кривая Q–H установки, рабочая точка при расчётных Q и H и линия требуемого напора." />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Результаты: файлы выпуска и замечания. -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <StackPanel x:Name="ResultsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.H3}" Text="Результатов пока нет" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Text="После расчёта здесь появятся файлы выпуска и замечания." />
                        </StackPanel>

                        <TabControl x:Name="ResultsTabs" Visibility="Collapsed" Margin="4">
                            <TabItem x:Name="FilesTab">
                                <TabItem.Header>
                                    <TextBlock x:Name="FilesTabHeader" Text="Файлы выпуска" />
                                </TabItem.Header>
                                <Grid Margin="12,8,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                                   Text="Двойной щелчок открывает файл. " />
                                        <Button Content="Открыть папку выпуска" Style="{StaticResource Button.Ghost}"
                                                Click="OnOpenOutFolder" Padding="8,2" />
                                        <Button x:Name="PreviewButton" Content="Предпросмотр…"
                                                Style="{StaticResource Button.Ghost}" Padding="8,2" Margin="8,0,0,0"
                                                IsEnabled="False" Click="OnPreviewFile"
                                                ToolTip="Показать таблицу спецификации (.xlsx) или текст записки (.docx) прямо в программе: выберите файл в списке" />
                                    </StackPanel>
                                    <ListBox x:Name="FilesList" Grid.Row="1" MouseDoubleClick="OnOpenFile"
                                             SelectionChanged="OnFileSelectionChanged"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,12,2,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Value}" />
                                                            <Border Grid.Column="1" Style="{StaticResource Pill.Neutral}"
                                                                    Padding="7,0">
                                                                <TextBlock Text="{Binding ItemCount}"
                                                                           Style="{StaticResource Text.Caption}" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="42" Height="26" CornerRadius="5"
                                                            Background="{DynamicResource Brush.Accent.Soft}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Mono}"
                                                                   Foreground="{DynamicResource Brush.Accent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                                        <TextBlock Text="{Binding Size}" Style="{StaticResource Text.Caption}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Relative}" Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>

                            <TabItem x:Name="IssuesTab">
                                <TabItem.Header>
                                    <TextBlock x:Name="IssuesTabHeader" Text="Замечания" />
                                </TabItem.Header>
                                <Grid Margin="12,8,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                                   Text="Показать:" Margin="0,0,8,0" />
                                        <ComboBox x:Name="IssueFilter" Width="220" SelectionChanged="OnIssueFilterChanged">
                                            <ComboBoxItem Content="Все замечания" IsSelected="True" />
                                            <ComboBoxItem Content="Ошибки" />
                                            <ComboBoxItem Content="Предупреждения" />
                                            <ComboBoxItem Content="Информация" />
                                        </ComboBox>
                                    </StackPanel>
                                    <DataGrid x:Name="Issues" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False"
                                              SelectionMode="Single" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Уровень" Width="120" SortMemberPath="LevelOrder">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="LevelBadge" Style="{StaticResource Pill.Neutral}"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding LevelText}"
                                                                       Style="{StaticResource Text.Caption}" />
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding LevelKey}" Value="Error">
                                                                <Setter TargetName="LevelBadge" Property="Style" Value="{StaticResource Pill.Error}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LevelKey}" Value="Warning">
                                                                <Setter TargetName="LevelBadge" Property="Style" Value="{StaticResource Pill.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LevelKey}" Value="Info">
                                                                <Setter TargetName="LevelBadge" Property="Style" Value="{StaticResource Pill.Info}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="170" />
                                            <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Пункт" Binding="{Binding Clause}" Width="90" />
                                            <DataGridTextColumn Header="Место, мм" Binding="{Binding Location}" Width="150" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Панель действия: главная кнопка всегда на виду, рядом — сообщение о ходе расчёта. -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Bg.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Summary" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               Text="Выберите проект или создайте его по чертежу, заполните исходные данные и нажмите «Рассчитать»." />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Проект .waproj или чертёж DWG/DXF можно перетащить в окно." />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="RunProgress" Width="120" Height="4" Margin="0,0,16,0" IsIndeterminate="True"
                                 VerticalAlignment="Center" Visibility="Collapsed" />
                    <Button x:Name="RunButton" Content="Рассчитать" Style="{StaticResource Button.Primary}"
                            MinWidth="190" FontWeight="SemiBold" Click="OnRun"
                            ToolTip="Выполнить расчёт проекта и выпуск документов (F5)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Строка состояния: редакция норм, корень data, тема. -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Bg.App}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NormsStatus" Grid.Column="0" Style="{StaticResource Text.Caption}" Text="Нормы: —" />
                <TextBlock x:Name="RootStatus" Grid.Column="1" Style="{StaticResource Text.Caption}" Text=""
                           TextTrimming="CharacterEllipsis" Margin="16,0" HorizontalAlignment="Left" />
                <TextBlock x:Name="ThemeStatus" Grid.Column="2" Style="{StaticResource Text.Caption}" Text="Светлая тема" />
            </Grid>
        </Border>
    </Grid>
</Window>
