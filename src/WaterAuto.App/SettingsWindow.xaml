<Window x:Class="WaterAuto.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление и поведение"
        Width="700" Height="800" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg.App}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Text.H2}" Text="Оформление и поведение" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Тема, акцент и автоматизация сохраняются в настройках и применяются сразу." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Готово" Style="{StaticResource Button.Primary}" MinWidth="130" IsDefault="True"
                    IsCancel="True" Click="OnDone" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Тема -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H3}" Text="Тема" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Светлая и тёмная темы или автоматически — как в Windows." />
                        <WrapPanel>
                            <RadioButton x:Name="ThemeLight" Tag="Light" GroupName="Theme" Content="Светлая"
                                         Margin="0,0,20,0" Checked="OnThemeChecked" />
                            <RadioButton x:Name="ThemeDark" Tag="Dark" GroupName="Theme" Content="Тёмная"
                                         Margin="0,0,20,0" Checked="OnThemeChecked" />
                            <RadioButton x:Name="ThemeSystem" Tag="System" GroupName="Theme"
                                         Content="Как в системе" Checked="OnThemeChecked" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Акцент -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H3}" Text="Акцентный цвет" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Цвет кнопок, выделения и графиков." />
                        <WrapPanel>
                            <RadioButton x:Name="AccentBlue" Tag="Blue" GroupName="Accent" Checked="OnAccentChecked"
                                         Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="8" Background="#2563EB"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Синий" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="AccentTeal" Tag="Teal" GroupName="Accent" Checked="OnAccentChecked"
                                         Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="8" Background="#0F766E"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Бирюзовый" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="AccentIndigo" Tag="Indigo" GroupName="Accent" Checked="OnAccentChecked">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="8" Background="#4F46E5"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Индиго" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Поведение -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H3}" Text="Поведение" />
                        <CheckBox x:Name="AutoCalcCheck" Margin="0,10,0,0"
                                  Content="Рассчитывать сразу после сохранения исходных данных"
                                  Checked="OnAutoCalcChanged" Unchecked="OnAutoCalcChanged" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="24,4,0,0"
                                   Text="Мастер сохранил данные — программа сама выполняет расчёт и показывает сводку. Если выключено, расчёт запускается кнопкой «Рассчитать»." />
                        <CheckBox x:Name="OpenOutDirCheck" Margin="0,14,0,0"
                                  Content="Открывать папку выпуска после расчёта"
                                  Checked="OnOpenOutDirChanged" Unchecked="OnOpenOutDirChanged" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="24,4,0,0"
                                   Text="После успешного расчёта проводник откроет папку с планом, спецификацией и запиской." />
                    </StackPanel>
                </Border>

                <!-- Профиль титульного листа -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H3}" Text="Профиль титульного листа" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Подставляется в новые проекты: организация, подписи, шифр, город и год, стадия. Изменения сохраняются автоматически; пустое поле в новый проект не подставляется." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Label}"
                                       Margin="0,0,8,8" Text="Организация" />
                            <TextBox x:Name="TitleOrganizationBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                     LostFocus="OnTitleTextBoxLostFocus" KeyDown="OnTitleTextBoxKeyDown" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.Label}"
                                       Margin="0,0,8,8" Text="Разработчик" />
                            <TextBox x:Name="TitleAuthorBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                     LostFocus="OnTitleTextBoxLostFocus" KeyDown="OnTitleTextBoxKeyDown" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.Label}"
                                       Margin="0,0,8,8" Text="Руководитель" />
                            <TextBox x:Name="TitleSupervisorBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                     LostFocus="OnTitleTextBoxLostFocus" KeyDown="OnTitleTextBoxKeyDown" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.Label}"
                                       Margin="0,0,8,8" Text="Шифр" />
                            <TextBox x:Name="TitleCodeBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                                     LostFocus="OnTitleTextBoxLostFocus" KeyDown="OnTitleTextBoxKeyDown" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Text.Label}"
                                       Margin="0,0,8,8" Text="Город, год" />
                            <TextBox x:Name="TitleCityYearBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                                     LostFocus="OnTitleTextBoxLostFocus" KeyDown="OnTitleTextBoxKeyDown" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Text.Label}"
                                       Margin="0,0,8,8" Text="Наименование здания" />
                            <TextBox x:Name="TitleBuildingBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                                     LostFocus="OnTitleTextBoxLostFocus" KeyDown="OnTitleTextBoxKeyDown" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Text.Label}"
                                       Margin="0,0,8,0" Text="Стадия" />
                            <ComboBox x:Name="TitleStageCombo" Grid.Row="6" Grid.Column="1"
                                      HorizontalAlignment="Left" MinWidth="280"
                                      SelectionChanged="OnTitleStageChanged">
                                <ComboBoxItem Content="Р — рабочая документация" Tag="Р" />
                                <ComboBoxItem Content="П — проектная" Tag="П" />
                            </ComboBox>
                        </Grid>
                        <Button Content="Очистить профиль" Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Padding="8,2"
                                Click="OnClearTitleProfile"
                                ToolTip="Сбросить профиль: в новые проекты значения не подставляются, стадия — Р" />
                    </StackPanel>
                </Border>

                <!-- О программе -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H3}" Text="О программе" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Caption}" Text="Версия" />
                            <TextBlock x:Name="VersionText" Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.Body}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.Caption}" Text="Нормы" Margin="0,6,0,0" />
                            <TextBlock x:Name="NormsText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.Caption}" Text="Данные" Margin="0,6,0,0" />
                            <TextBlock x:Name="DataRootText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.Caption}" Text="Настройки" Margin="0,6,0,0" />
                            <TextBlock x:Name="SettingsPathText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Button Content="Открыть папку настроек" Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="8,2" Click="OnOpenSettingsFolder" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
