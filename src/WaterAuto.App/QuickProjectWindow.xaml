<Window x:Class="WaterAuto.App.QuickProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Быстрый проект по чертежу"
        Width="820" Height="820" MinWidth="720" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg.App}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: что делает быстрый проект и по каким данным он считается. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="Быстрый проект по чертежу" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Выберите чертёж плана и группу помещений — программа создаст проект *.waproj, подставит оценки по геометрии чертежа и передаст проект главному окну для расчёта. Остальные данные можно уточнить в мастере исходных данных." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                               Text="Нормы и каталоги" />
                    <TextBlock x:Name="DataStatusText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                               MaxWidth="320" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                               Text="—" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- data/norms не найдена или прочитана частично: диалог работает, но создание ограничено. -->
        <Border x:Name="SourceBanner" Grid.Row="1" Visibility="Collapsed" Margin="20,12,20,0" Padding="12,8"
                CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource Brush.Warning.Soft}" BorderBrush="{DynamicResource Brush.Warning}">
            <TextBlock x:Name="SourceBannerText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Warning}" />
        </Border>

        <!-- Проект рядом с чертежом уже есть: он не перезаписывается, открывается существующий. -->
        <Border x:Name="ExistingBanner" Grid.Row="2" Visibility="Collapsed" Margin="20,12,20,0" Padding="12,8"
                CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource Brush.Warning.Soft}" BorderBrush="{DynamicResource Brush.Warning}">
            <TextBlock x:Name="ExistingBannerText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Warning}"
                       Text="Проект уже существует — будет открыт существующий: новые данные не применяются, файл не перезаписывается." />
        </Border>

        <!-- Ошибки заполнения полей: без MessageBox, строкой над содержимым. -->
        <Border x:Name="ErrorBanner" Grid.Row="3" Visibility="Collapsed" Margin="20,12,20,0" Padding="12,8"
                CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource Brush.Error.Soft}" BorderBrush="{DynamicResource Brush.Error}">
            <TextBlock x:Name="ErrorBannerText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Error}" />
        </Border>

        <!-- Содержимое диалога: чертёж с предпроверкой и минимум стандартных данных. -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H3}" Text="1 · Чертёж плана" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                   Text="Файл DWG/DXF по соглашению о слоях ПТ_: контуры помещений, помещение насосной, точки ввода и балки. Проект создаётся в папке чертежа." />

                        <TextBlock Style="{StaticResource Text.Label}" Text="Файл чертежа (DWG или DXF)" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DrawingBox" TextChanged="OnDrawingTextChanged"
                                     ToolTip="Полный или относительный путь к чертежу DWG/DXF" />
                            <Button Grid.Column="1" Content="Выбрать…" Style="{StaticResource Button.Secondary}"
                                    Margin="8,0,0,0" Click="OnBrowseDrawing"
                                    ToolTip="Выбрать чертёж плана DWG/DXF" />
                        </Grid>
                        <TextBlock x:Name="DrawingErrorText" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Visibility="Collapsed" />

                        <!-- Сводка предпроверки: что распознано, какие данные будут подставлены и какие есть замечания. -->
                        <Border Style="{StaticResource Card.Inset}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource Text.Label}" Text="Предпроверка чертежа" />
                                        <TextBlock x:Name="PreviewText" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Выберите файл чертежа — программа покажет, что распознано на плане." />
                                    </StackPanel>
                                    <Border x:Name="PreviewPill" Grid.Column="1" Style="{StaticResource Pill.Neutral}"
                                            VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <TextBlock x:Name="PreviewStatusText" Style="{StaticResource Text.Caption}"
                                                   Text="Ожидает чертёж" />
                                    </Border>
                                </Grid>

                                <!-- Какие исходные данные будут подставлены по геометрии чертежа. -->
                                <StackPanel x:Name="SuggestionsBlock" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="SuggestionsTitle" Style="{StaticResource Text.Label}"
                                               Text="Будет подставлено по чертежу" />
                                    <TextBlock x:Name="SuggestionsDisabledHint" Style="{StaticResource Text.Caption}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Warning}" Visibility="Collapsed"
                                               Text="Оценки не будут применены — включите «Применить оценки по чертежу»." />
                                    <ScrollViewer x:Name="SuggestionsScroll" MaxHeight="140" Margin="0,6,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="Collapsed">
                                        <StackPanel x:Name="SuggestionsList" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="SuggestionsEmpty" Style="{StaticResource Text.Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                               Text="Предложений нет: в чертеже нет балок/отметок или данные уже заданы." />
                                </StackPanel>

                                <!-- Замечания импорта и предпроверки: ошибки, предупреждения, информация. -->
                                <StackPanel x:Name="IssuesBlock" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="IssuesTitle" Style="{StaticResource Text.Label}"
                                               Text="Замечания предпроверки" />
                                    <ScrollViewer x:Name="IssuesScroll" MaxHeight="120" Margin="0,6,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="Collapsed">
                                        <StackPanel x:Name="IssuesList" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="IssuesEmpty" Style="{StaticResource Text.Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                               Text="Критических замечаний нет." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.H3}" Text="2 · Стандартные данные" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                   Text="Минимум, без которого расчёт не начнётся: группа помещений. Ороситель и комплектную установку программа подберёт по каталогу, если не выбирать вручную." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource Text.Label}" Text="Группа помещений"
                                       VerticalAlignment="Center" Margin="0,0,16,12"
                                       ToolTip="Строка табл. 6.1 СП 485: интенсивность, расчётный расход, площадь и шаг для группы." />
                            <ComboBox x:Name="RoomGroupBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"
                                      SelectionChanged="OnDataSelectionChanged"
                                      ToolTip="Группа помещений по приложению А СП 485: в подписи — параметры строки табл. 6.1." />

                            <TextBlock Grid.Row="1" Style="{StaticResource Text.Label}" Text="Ороситель"
                                       VerticalAlignment="Center" Margin="0,0,16,12"
                                       ToolTip="Модель из каталога data/catalog/sprinklers.json: при выборе в проект попадут K, модель и положение розетки." />
                            <ComboBox x:Name="SprinklerBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                                      SelectionChanged="OnDataSelectionChanged"
                                      ToolTip="«Автоподбор по каталогу» — K и модель подберёт расчёт; иначе выберите модель." />

                            <TextBlock Grid.Row="2" Style="{StaticResource Text.Label}" Text="Комплектная установка"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       ToolTip="Установка из каталога data/catalog/pump_sets_*.json; без выбора подбирается по расчётным Q и H." />
                            <ComboBox x:Name="PumpSetBox" Grid.Row="2" Grid.Column="1"
                                      SelectionChanged="OnDataSelectionChanged"
                                      ToolTip="«Автоподбор по Q и H» — установку подберёт расчёт; иначе выберите из каталога." />
                        </Grid>

                        <CheckBox x:Name="ApplySuggestionsBox" Margin="0,16,0,0" IsChecked="True"
                                  Content="Применить оценки по чертежу (высота помещения, отметки, H, подводящий)"
                                  Checked="OnApplySuggestionsChanged" Unchecked="OnApplySuggestionsChanged"
                                  ToolTip="Геометрия чертежа даёт высоту помещения и насосной, отметку труб, H над осью насоса и длину подводящего трубопровода. Значения-оценки будут видны и редактируемы в мастере." />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Оценки — не расчёт: они появятся в мастере исходных данных с основанием и останутся доступны для правки до расчёта." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Действия: создание проекта (главный путь) и отмена без изменений. -->
        <Border Grid.Row="5" Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FooterHint" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,16,0"
                           Text="Укажите файл чертежа DWG/DXF — проект *.waproj создаётся рядом с ним и открывается для расчёта." />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CreateButton" Style="{StaticResource Button.Primary}" Content="Создать проект"
                            IsDefault="True" MinWidth="170" Click="OnCreate"
                            ToolTip="Создать проект и передать его главному окну для расчёта" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Отмена" IsCancel="True"
                            MinWidth="110" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
