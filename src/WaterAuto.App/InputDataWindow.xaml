<Window x:Class="WaterAuto.App.InputDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Исходные данные проекта"
        Width="1080" Height="820" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg.App}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: что за проект и по какой редакции норм считается. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H2}" Text="Исходные данные проекта" />
                    <TextBlock x:Name="ProjectNameText" Style="{StaticResource Text.Value}" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ProjectPathText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Только данные объекта и решения проектировщика: нормы и каталоги программа берёт из data/, пустое поле — значение по умолчанию. Сохранение — в файл *.waproj." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource Text.Label}" HorizontalAlignment="Right" Text="Расчёт по нормам" />
                    <TextBlock x:Name="NormsText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                               MaxWidth="280" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Предупреждение: data/ не найдена или прочитана частично. -->
        <Border x:Name="SourceBanner" Grid.Row="1" Visibility="Collapsed" Margin="20,12,20,0" Padding="12,8"
                CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource Brush.Warning.Soft}" BorderBrush="{DynamicResource Brush.Warning}">
            <TextBlock x:Name="SourceBannerText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Warning}" />
        </Border>

        <!-- Ошибки проверки введённых значений: без MessageBox, строкой над содержимым. -->
        <Border x:Name="ErrorBanner" Grid.Row="2" Visibility="Collapsed" Margin="20,12,20,0" Padding="12,8"
                CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource Brush.Error.Soft}" BorderBrush="{DynamicResource Brush.Error}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Label}" Text="Проверьте заполнение полей"
                           Foreground="{DynamicResource Brush.Error}" />
                <TextBlock x:Name="ErrorBannerText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" />
            </StackPanel>
        </Border>

        <!-- Разделы мастера: навигация слева, карточки полей справа. -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Brush.Bg.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="Разделы" Margin="16,16,16,8" />
                    <ListBox x:Name="Nav" Style="{StaticResource ListBox.Nav}" Margin="8,0"
                             SelectionChanged="OnNavSelectionChanged" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="SectionScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SectionHost" Margin="20,4,20,24" />
            </ScrollViewer>
        </Grid>

        <!-- Низ: прогресс заполнения и действия. -->
        <Border Grid.Row="4" Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FillCountText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           Text="Заполнено полей: 0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Style="{StaticResource Button.Primary}" Content="Сохранить"
                            IsDefault="True" MinWidth="140" Click="OnSave" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Отмена" IsCancel="True"
                            MinWidth="110" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
