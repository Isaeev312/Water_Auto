<Window x:Class="WaterAuto.App.InputDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Исходные данные проекта" Height="800" Width="1060" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555"
                   Text="Данные объекта и решения проектировщика. Нормы здесь не задаются — они берутся из data/norms. Пустое поле — значение по умолчанию (подсказка в подсказке к полю)." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Width="130" IsDefault="True" Click="OnSave" Padding="8,4" />
            <Button Content="Отмена" Width="100" Margin="8,0,0,0" IsCancel="True" Padding="8,4" />
        </StackPanel>
        <TabControl x:Name="Tabs" Margin="0,10,0,0" />
    </DockPanel>
</Window>
