<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Токены светлой темы. Набор ключей ОБЯЗАН совпадать с Tokens.Dark.xaml.
        На эти ключи ссылаются Controls.xaml, окна и ThemeManager — имена не менять.
    -->

    <!-- Бренд -->
    <SolidColorBrush x:Key="Brush.Brand" Color="#1E3A5F" />
    <SolidColorBrush x:Key="Brush.Text.OnBrand" Color="#FFFFFF" />

    <!-- Фон и поверхности -->
    <SolidColorBrush x:Key="Brush.Bg.App" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Bg.SurfaceAlt" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Brush.Bg.SurfaceHover" Color="#F1F5F9" />

    <!-- Рамки -->
    <SolidColorBrush x:Key="Brush.Border" Color="#E4E7EB" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#CBD5E1" />

    <!-- Текст -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#0F172A" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#475569" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#64748B" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#94A3B8" />

    <!-- Выделение и фокус -->
    <SolidColorBrush x:Key="Brush.Selection" Color="#DBEAFE" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#2563EB" />

    <!-- Семантика -->
    <SolidColorBrush x:Key="Brush.Success" Color="#059669" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#ECFDF5" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#FFFBEB" />
    <SolidColorBrush x:Key="Brush.Error" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.Error.Soft" Color="#FEF2F2" />
    <SolidColorBrush x:Key="Brush.Info" Color="#0284C7" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#F0F9FF" />

    <!-- Прокрутка и оверлеи -->
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="#94A3B8" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#80000000" />

    <!-- Размеры (8px ритм) -->
    <sys:Double x:Key="Size.Radius.Small">4</sys:Double>
    <sys:Double x:Key="Size.Radius.Medium">8</sys:Double>
    <sys:Double x:Key="Size.Radius.Large">12</sys:Double>
    <sys:Double x:Key="Size.Control.Height">34</sys:Double>
    <sys:Double x:Key="Size.Control.Height.Small">28</sys:Double>
    <sys:Double x:Key="Size.Gap">8</sys:Double>

</ResourceDictionary>
