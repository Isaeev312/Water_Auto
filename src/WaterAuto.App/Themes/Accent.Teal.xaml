<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Акцент: бирюзовый. Значения подобраны так, чтобы белый текст на кнопке проходил WCAG AA (≥4,5:1).
         Набор ключей одинаков для всех Accent.*.xaml. -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#0F766E" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#115E59" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#134E4A" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#1A0F766E" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

</ResourceDictionary>
