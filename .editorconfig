root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,xaml,slnf}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sln]
end_of_line = crlf
indent_style = tab

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Имена тестов пишутся через подчёркивание: Calc_does_not_reference_io_or_ui
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
