{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Isaeev312/Water_Auto/data/schemas/membrane_tanks.schema.json",
  "title": "Мембранные баки (гидроаккумуляторы) для жокей-насоса: вместимость, PN, заводское давление воздуха",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "maker", "verified", "source", "tanks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "maker": { "type": "string" },
    "verified": { "type": "boolean" },
    "source": { "type": "string", "description": "Паспорт или каталог изготовителя, откуда взяты числа." },
    "notes": { "type": "array", "items": { "type": "string" } },
    "tanks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["designation", "volumeL", "pnBar", "prechargeBar", "document"],
        "properties": {
          "designation": { "type": "string", "description": "Артикул и наименование для спецификации." },
          "volumeL": { "type": "number", "exclusiveMinimum": 0 },
          "pnBar": { "type": "number", "exclusiveMinimum": 0, "description": "Максимальное рабочее давление, бар." },
          "prechargeBar": { "type": "number", "minimum": 0, "description": "Заводское давление воздуха, бар." },
          "document": { "type": "string", "description": "Обозначение документа для графы 3 спецификации (ТУ, паспорт)." }
        }
      }
    }
  }
}
