{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Isaeev312/Water_Auto/data/schemas/pipe_sizes.schema.json",
  "title": "Принятые размеры труб (наружный диаметр × стенка) по DN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sizes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "standard",
          "dn",
          "outerDiameter",
          "wall"
        ],
        "properties": {
          "standard": {
            "type": "string",
            "description": "Стандарт без года, как в табл. Б.2: «ГОСТ 10704»."
          },
          "dn": {
            "type": "integer"
          },
          "outerDiameter": {
            "type": "number"
          },
          "wall": {
            "type": "number"
          },
          "alternativeWall": {
            "type": "number",
            "description": "Допустимая другая стенка (для справки)."
          }
        }
      }
    },
    "defaultDesignVelocity": {
      "type": "number",
      "description": "Скорость для подбора диаметров по Б.5, когда в проекте не задана (практика проектирования, не норма)."
    }
  }
}