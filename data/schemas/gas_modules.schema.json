{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Isaeev312/Water_Auto/data/schemas/gas_modules.schema.json",
  "title": "Модули газового пожаротушения: паспортные данные для числа модулей по прил. Д и п. 9.6.5 СП 485",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "verified": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "designation",
          "manufacturer",
          "volume",
          "charges",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "volume": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pressure": {
            "type": "number"
          },
          "startCurrent": {
            "type": "number"
          },
          "safeCurrent": {
            "type": "number"
          },
          "certificate": {
            "type": "string"
          },
          "charges": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxFill"
              ],
              "properties": {
                "maxFill": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "residue": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  }
}