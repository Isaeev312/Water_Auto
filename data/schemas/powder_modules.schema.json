{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Isaeev312/Water_Auto/data/schemas/powder_modules.schema.json",
  "title": "Модули порошкового пожаротушения: паспортные данные для расчёта количества по прил. И СП 485",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "verified": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "designation", "manufacturer", "powder", "impulse", "minHeight", "maxHeight", "coverage", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "designation": { "type": "string", "minLength": 1 },
          "manufacturer": { "type": "string", "minLength": 1 },
          "powder": { "type": "string", "enum": ["AB", "B"], "description": "Порошок для классов А, В или только В (строка табл. И.1)." },
          "impulse": { "type": "boolean" },
          "minHeight": { "type": "number", "minimum": 0, "description": "Наименьшая высота установки, м." },
          "maxHeight": { "type": "number", "exclusiveMinimum": 0, "description": "Наибольшая высота установки, м." },
          "coverage": {
            "type": "array",
            "minItems": 1,
            "description": "Диаграмма распыла: на высоте установки — защищаемая площадь по классам А и В, м², объём, м³ (чего нет в паспорте — не указывать).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heightM"],
              "properties": {
                "heightM": { "type": "number", "exclusiveMinimum": 0 },
                "areaA": { "type": "number", "exclusiveMinimum": 0 },
                "areaB": { "type": "number", "exclusiveMinimum": 0 },
                "volume": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          },
          "k1": { "type": "number", "minimum": 1 },
          "k2": { "type": "number", "minimum": 1, "description": "Коэффициент запаса на затенения по огневым испытаниям изготовителя (прил. И)." },
          "k4": { "type": "number", "minimum": 1 },
          "fireRank": { "type": "string" },
          "powderMass": { "type": "number", "exclusiveMinimum": 0 },
          "mass": { "type": "number", "exclusiveMinimum": 0 },
          "startCurrent": { "type": "number", "exclusiveMinimum": 0, "description": "Ток пуска, А." },
          "startDuration": { "type": "number", "exclusiveMinimum": 0, "description": "Длительность импульса пуска, с." },
          "monitorCurrent": { "type": "number", "minimum": 0, "description": "Ток контроля цепи пуска, А." },
          "selfStartTemperature": { "type": "number" },
          "certificate": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
