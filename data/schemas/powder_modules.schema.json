{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Isaeev312/Water_Auto/data/schemas/powder_modules.schema.json",
  "title": "Модули порошкового пожаротушения: паспортные данные для расчёта количества по прил. И СП 485",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "verified": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "designation",
          "manufacturer",
          "powder",
          "impulse",
          "coverage",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "powder": {
            "type": "string",
            "enum": [
              "AB",
              "B"
            ],
            "description": "Порошок для классов А, В или только В (строка табл. И.1)."
          },
          "impulse": {
            "type": "boolean"
          },
          "coverage": {
            "type": "array",
            "minItems": 1,
            "description": "Отрезки высот установки по паспорту: значения на концах, внутри — линейно (интерполяция по таблице или формула паспорта на концах); одна точка — from = to.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "atFrom",
                "atTo"
              ],
              "properties": {
                "from": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "to": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "atFrom": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "areaA": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "areaB": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "volumeA": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "volumeB": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "description": "Защищаемая площадь, м², и объём, м³, по классам А и В (чего нет в паспорте — не указывать)."
                },
                "atTo": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "areaA": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "areaB": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "volumeA": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "volumeB": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "description": "Защищаемая площадь, м², и объём, м³, по классам А и В (чего нет в паспорте — не указывать)."
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "k1": {
            "type": "number",
            "minimum": 1
          },
          "fireRank": {
            "type": "string"
          },
          "powderMass": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mass": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "startCurrent": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Ток пуска, не менее, А (по паспорту)."
          },
          "startDuration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Длительность импульса пуска, с."
          },
          "monitorCurrent": {
            "type": "number",
            "minimum": 0,
            "description": "Безопасный ток проверки цепи пуска по паспорту, А (ток контроля прибора пуска должен быть не больше)."
          },
          "selfStartTemperature": {
            "type": "number"
          },
          "certificate": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          },
          "k2Factor": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "k2 = 1 + k2Factor·Sз/Sу по формуле паспорта."
          },
          "k2Limit": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Порог Sз/Sу, выше которого изготовитель рекомендует доп. модули."
          },
          "k4Area": {
            "type": "number",
            "minimum": 1,
            "description": "k4 по документации для тушения по площади (всей и локально)."
          },
          "k4Volume": {
            "type": "number",
            "minimum": 1,
            "description": "k4 по документации для тушения по объёму."
          }
        }
      }
    }
  }
}
