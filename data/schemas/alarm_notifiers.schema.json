{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Isaeev312/Water_Auto/data/schemas/alarm_notifiers.schema.json",
  "title": "Оповещатели СОУЭ и релейные блоки управления: паспортные данные моделей для выбора в проекте",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "notifiers",
    "relays"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "verified": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "designation",
          "manufacturer",
          "loopCurrent",
          "addresses",
          "standbyCurrent",
          "alarmCurrent",
          "voltage",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sound",
              "speech",
              "light"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "levelAt1m": {
            "type": "number",
            "description": "Уровень звука на 1 м, дБ (наименьший по паспорту); у световых отсутствует."
          },
          "loopCurrent": {
            "type": "number",
            "minimum": 0,
            "description": "Ток от адресной линии, А."
          },
          "addresses": {
            "type": "integer",
            "minimum": 0
          },
          "standbyCurrent": {
            "type": "number",
            "minimum": 0,
            "description": "Ток от линии питания в дежурном режиме, А."
          },
          "alarmCurrent": {
            "type": "number",
            "minimum": 0,
            "description": "Ток от линии питания при оповещении, А."
          },
          "voltage": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "certificate": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          },
          "sensitivityDb": {
            "type": "number",
            "description": "Речевые: чувствительность SPL, дБ при 1 Вт на 1 м (паспорт)."
          },
          "taps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "acousticW",
                "consumedW"
              ],
              "properties": {
                "acousticW": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "consumedW": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "description": "Речевые: отводы трансформатора — акустическая и потребляемая от линии мощность, Вт."
          },
          "lineVoltage": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Речевые: номинальное напряжение линии, В."
          }
        }
      }
    },
    "relays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "designation",
          "manufacturer",
          "outputs",
          "loopCurrent",
          "addresses",
          "standbyCurrent",
          "alarmCurrent",
          "voltage",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "integer",
            "minimum": 1,
            "description": "Выходов (реле) в блоке."
          },
          "loopCurrent": {
            "type": "number",
            "minimum": 0
          },
          "addresses": {
            "type": "integer",
            "minimum": 0
          },
          "standbyCurrent": {
            "type": "number",
            "minimum": 0
          },
          "alarmCurrent": {
            "type": "number",
            "minimum": 0
          },
          "voltage": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "certificate": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "amplifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "designation",
          "manufacturer",
          "maxConsumedW",
          "maxAcousticW",
          "maxBranches",
          "maxSegmentM",
          "lineVoltage",
          "batteryName",
          "batteries",
          "backupStandbyH",
          "backupAlarmH",
          "mainsW",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "maxConsumedW": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxAcousticW": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxBranches": {
            "type": "integer",
            "minimum": 1
          },
          "maxSegmentM": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "lineVoltage": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "batteryName": {
            "type": "string"
          },
          "batteries": {
            "type": "integer",
            "minimum": 0
          },
          "backupStandbyH": {
            "type": "number",
            "minimum": 0
          },
          "backupAlarmH": {
            "type": "number",
            "minimum": 0
          },
          "mainsW": {
            "type": "number",
            "minimum": 0
          },
          "certificate": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "lineMonitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "designation",
          "manufacturer",
          "lineCurrent",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "lineCurrent": {
            "type": "number",
            "minimum": 0
          },
          "certificate": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
