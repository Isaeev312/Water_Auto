{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Isaeev312/Water_Auto/data/schemas/documents.schema.json",
  "title": "Справочник наименований документов для ведомости ссылочных документов",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "designation",
          "name"
        ],
        "properties": {
          "designation": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  }
}